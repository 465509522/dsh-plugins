{
  "name": "dsh-usage-today",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Today's token usage and estimated cost strip below the composer",
  "author": "465509522",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/465509522/dsh-plugins.git",
    "directory": "usage-today"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
